# PDFs must be inside the project static directory for browser viewing.
# On a server, mount your persistent PDF collection at static/pdfs.
DOCUMENTS_DIR=static/pdfs

# Optional; defaults to .local-data/document_index.json.
INDEX_PATH=.local-data/document_index.json

# Local development only. Leave unset or false on a public deployment.
ENABLE_ADMIN_CONTROLS=true
