# Optional; defaults to the bundled demo PDFs in static/pdfs.
# Set to .local-data/pdfs after downloading the full Census collection.
# DOCUMENTS_DIR=.local-data/pdfs

# Optional; defaults to .local-data/document_index.json.
INDEX_PATH=.local-data/document_index.json

# Use local for development, or public for a hosted deployment.
PDF_ACCESS_MODE=local

# Optional public PDF base URL for public access with files outside the
# bundled demo folder, such as a public CDN URL backed by an S3 bucket.
# Private or presigned S3 URLs are not supported yet.
# PDF_BASE_URL=
